{
  "expo": {
    "name": "One-day local services",
    "slug": "one-day-local-services",
    "version": "1.0.0",
    "scheme": "com.promiseedge.fixmate.app",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8FAFC"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow One-day local services to use your location to find nearby service providers."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow One-day local services to attach job photos for quotes and completion proof."
        }
      ],
      "expo-web-browser"
    ],
    "android": {
      "package": "com.promiseedge.fixmate.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.promiseedge.fixmate.app"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "df08aff9-2123-4c57-87fc-43cc7af628b0"
      }
    },
    "owner": "invoice-gen-account"
  }
}
