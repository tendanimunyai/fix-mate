{
  "expo": {
    "name": "FixMate",
    "slug": "fixmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8FAFC"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow FixMate to use your location to find nearby service providers."
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.promiseedge.fixmate.app"
    },
    "ios": {
      "bundleIdentifier": "com.promiseedge.fixmate.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
