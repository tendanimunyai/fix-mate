rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function profileRole() {
      return hasProfile() ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role : '';
    }

    function role() {
      return signedIn() && request.auth.token.role is string ? request.auth.token.role : profileRole();
    }

    function isAdmin() {
      return role() in ['administrator', 'system-admin'];
    }

    function isProvider() {
      return role() == 'provider';
    }

    function isCustomer() {
      return role() == 'customer';
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isCustomer() || isProvider() || isAdmin());
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read, update: if signedIn();
      allow create: if signedIn();
      allow delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /providers/{providerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /profiles/{profileId} {
      allow read, update: if isAdmin() || (signedIn() && profileId == request.auth.uid);
      allow create: if signedIn() && profileId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /providerStatuses/{providerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /availability/{providerId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isProvider();
    }
  }
}
