rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function profileRole() {
      return hasProfile() ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role : '';
    }

    function role() {
      return signedIn() && request.auth.token.role is string ? request.auth.token.role : profileRole();
    }

    function isAdmin() {
      return role() in ['administrator', 'system-admin'];
    }

    function isProvider() {
      return role() == 'provider';
    }

    function approvedProviderEmail(email) {
      return signedIn()
        && request.auth.token.email == email
        && exists(/databases/$(database)/documents/providers/$(email))
        && exists(/databases/$(database)/documents/providerStatuses/$(email))
        && get(/databases/$(database)/documents/providerStatuses/$(email)).data.status == 'approved';
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read, update: if signedIn();
      allow create: if signedIn();
      allow delete: if isAdmin();
    }

    match /notificationTokens/{tokenId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /providers/{providerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /providerApplications/{applicationId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && !(request.resource.data.status in ['approved', 'rejected']));
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if isAdmin() || (signedIn() && profileId == request.auth.uid);
      allow create: if signedIn() && profileId == request.auth.uid && (
        request.resource.data.role == 'customer'
        || (
          request.resource.data.role == 'provider'
          && request.resource.data.email == request.auth.token.email
          && approvedProviderEmail(request.resource.data.email)
        )
      );
      allow update: if isAdmin() || (signedIn() && profileId == request.auth.uid
        && request.resource.data.email == resource.data.email
        && (
          request.resource.data.id == resource.data.id
          || (!resource.data.keys().hasAny(['id']) && request.resource.data.id == profileId)
        )
        && (
          request.resource.data.role == resource.data.role
          || (
            resource.data.role == 'customer'
            && request.resource.data.role == 'provider'
            && request.resource.data.email == request.auth.token.email
            && approvedProviderEmail(request.resource.data.email)
          )
        ));
      allow delete: if isAdmin();
    }

    match /providerStatuses/{providerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /availability/{providerId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isProvider();
    }

    match /systemSettings/{settingId} {
      allow read: if signedIn();
      allow write: if role() == 'system-admin';
    }
  }
}
